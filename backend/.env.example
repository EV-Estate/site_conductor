# Backend configuration. Copy to backend/.env for local dev (gitignored).
# Topology (DATABASE_URL, BIND_ADDR) DEFAULTS from flake.nix (the `ports`
# attrset); anything set here or in the environment wins. Normally secrets only.

SITE_URL=https://estate.evinvest.ltd
APP_ENV=development

# Browser origins allowed to call the API cross-origin, comma-separated, each a
# bare scheme://host[:port]. Unset ⇒ any origin (dev); required in production.
CORS_ALLOWED_ORIGINS=

# Email — Gmail SMTP. Unset ⇒ emails are logged, not delivered.
# For Gmail use an App Password (not the account password) with 2FA enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Quoted: `nix run .#backend` sources this file with the shell, where a bare
# `<` is a redirect — dotenvy strips the quotes, so both readers agree.
MAIL_FROM="EV Investment <admin@evinvest.ltd>"
MAIL_TEAM=admin@evinvest.ltd

# Error monitoring — Sentry. Unset ⇒ no-op.
SENTRY_DSN=

# Product analytics — PostHog (server-side capture). Unset ⇒ no-op.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
